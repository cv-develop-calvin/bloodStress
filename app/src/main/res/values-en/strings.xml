    <!-- Privacy consent -->
    <string name="privacy_dialog_title">Privacy Policy</string>
    <string name="privacy_dialog_intro">Thanks for using SongBaoBao Health. Please read and accept the Privacy Policy and Terms of Use before you start recording.</string>
    <string name="privacy_dialog_points">Key points:</string>
    <string name="privacy_point_1">Blood pressure, medication, blood test and note data stay on your device and are never uploaded;</string>
    <string name="privacy_point_2">Network is used only for update checks, APK download and pharmacy links;</string>
    <string name="privacy_point_3">Crash logs are local and only sent when you choose to share;</string>
